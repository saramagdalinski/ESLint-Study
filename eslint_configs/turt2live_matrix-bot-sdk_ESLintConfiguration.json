        "classMethod",
        "typeMethod",
        "classMethod",
        "typeMethod",
        "accessor"
      ],
      "format": [
        "camelCase"
      ],
      "leadingUnderscore": "forbid"
    },
    {
      "selector": [
        "function",
        "parameter",
        "objectLiteralMethod"
      ],
      "format": [
        "camelCase",
        "PascalCase"
      ],
      "leadingUnderscore": "allow"
    },
    {
      "selector": [
        "class",
        "typeAlias",
        "typeParameter"
      ],
      "format": [
        "PascalCase"
      ],
      "leadingUnderscore": "forbid"
    }
