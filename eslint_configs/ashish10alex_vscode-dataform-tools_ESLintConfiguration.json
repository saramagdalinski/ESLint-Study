{
  "@typescript-eslint/naming-convention": [
    "warn",
    {
      "selector": "import",
      "format": [
        "camelCase",
        "PascalCase"
      ]
    }
  ],
  "@typescript-eslint/semi": [
    "warn"
  ],
  "curly": [
    "warn"
  ],
  "eqeqeq": [
    "warn"
  ],
  "no-throw-literal": [
    "warn"
  ],
  "semi": [
    "off"
  ]
}